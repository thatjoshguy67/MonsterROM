From 3a1a82d3e6194cf803af3da00b9db8ec384c6ca0 Mon Sep 17 00:00:00 2001
From: ditternation <ditternation@outlook.com>
Date: Wed, 30 Sep 2026 17:29:49 +0200
Subject: [PATCH] Allow custom CONNECTION_PERSONALIZATION value

---

diff --git a/smali/com/samsung/android/server/wifi/SemWifiInjector.smali b/smali/com/samsung/android/server/wifi/SemWifiInjector.smali
index c5c0023340e0300a92ef3d047c05385de6d2b070..b8b652a17ea3e3e2b8edd325ed714d00b7c92b26 100644
--- a/smali/com/samsung/android/server/wifi/SemWifiInjector.smali
+++ b/smali/com/samsung/android/server/wifi/SemWifiInjector.smali
@@ -1982,7 +1982,11 @@
 
     new-instance v2, Lcom/samsung/android/server/wifi/connection/ConnectionPersonalizer;
 
-    const/4 v3, 0x3
+    const-string v3, "CONFIG_CONNECTION_PERSONALIZATION"
+
+    invoke-static {v3}, Ljava/lang/Integer;->parseInt(Ljava/lang/String;)I
+
+    move-result v3
 
     invoke-direct {v2, v1, v4, v0, v3}, Lcom/samsung/android/server/wifi/connection/ConnectionPersonalizer;-><init>(Landroid/content/Context;Lcom/samsung/android/server/wifi/SemWifiInjector;Landroid/os/HandlerThread;I)V
 
